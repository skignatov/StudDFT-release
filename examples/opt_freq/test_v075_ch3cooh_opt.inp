! v0.75.0 regression: acetic acid (CH3-COOH) opt+freq.
! Same root cause as the ethanol / acetaldehyde tests: pre-v0.75 the
! six methyl dihedrals around the C1-C2 bond were dropped.  v0.75.0
! must produce 8 dihedrals (6 methyl + 2 OH torsion) and converge.
! Starting geometry built from idealized sp2 / sp3 templates.
%method  HF
%basis   6-31G(d,p)
%job     opt+freq
%grid    fine
%charge  0
%mult    1
%spherical
%opt_maxiter  100

%geo
C       0.0000000000      0.0000000000      0.0000000000
C       1.5100000000      0.0000000000      0.0000000000
H       1.8500000000      1.0277000000      0.0000000000
H       1.8500000000     -0.5138500000      0.8900000000
H       1.8500000000     -0.5138500000     -0.8900000000
O      -0.6500000000      1.0276000000      0.0000000000
O      -0.6500000000     -1.0276000000      0.0000000000
H      -1.6100000000     -0.9800000000      0.0000000000

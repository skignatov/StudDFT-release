! v0.74.0 PCM test 5:  OH radical in water (UHF/STO-3G, IEFPCM).
!
! Verifies that the IEFPCM build path works through the UHF code
! path the same way it does for RHF.  Same molecule and geometry as
! test_v073_oh_uhf_cpcm.inp for direct comparison.
%method  HF
%basis   sto-3g
%spin    unrestricted
%charge  0
%mult    2
%job     energy
%pcm     iefpcm
%solvent water
%geom angstrom
O  0.000000   0.000000   0.000000
H  0.000000   0.000000   0.97
*end

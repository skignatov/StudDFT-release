! Oracle anchor, v1.21.0.  Single point at the EXACT geometry the
! reference program used, taken from its own input file.
!
! ORCA ran with Grid5 GridX5 IntAcc 6.0, TightSCF, NoRI, NoCOSX and
! SCF tolerances at 1e-10; StudDFT uses grid 8 (Treutler-Ahlrichs
! M4), which the verification protocol of the paper matches to it.
!
! Reference: B3LYP / cc-pVDZ, orca-6.0.1
%method  B3LYP
%basis   cc-pVDZ
%job     energy
%charge  0
%mult    1
%spherical
%grid    8
%scf_etol 1e-10
%scf_ptol 1e-8
%scf_diis_etol 1e-7
%geom angstrom
F       0.0000000000      0.0000000000      0.0000000000
Al      0.0000000000      0.0000000000      1.6300000000
F       1.4116214082      0.0000000000      2.4450000000
F      -1.4116214082      0.0000000000      2.4450000000
*end

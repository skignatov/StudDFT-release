! v1.12.0 trajectory oracle: smeared Ehrenfest on the DEGENERATE
! frontier (square H4, fermi 0.02: fractional f ~ 0.5).  Energy
! conservation must hold and scale as dt^2.
%method  PBE
%basis   3-21g
%grid    1
%job     energy
%scf_ptol 1e-8
%smearing fermi
%smearing_sigma 0.02
%ehrenfest 40
%eh_dt   5.0
%eh_esub 24
%eh_print_every 10
%geom angstrom
H 0.0 0.0 0.0
H 1.2 0.0 0.0
H 1.2 1.2 0.0
H 0.0 1.2 0.0
*end

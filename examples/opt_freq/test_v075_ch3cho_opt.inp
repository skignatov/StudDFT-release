! v0.75.0 regression: acetaldehyde (CH3-CHO) opt+freq.
! Pre-v0.75: generate_internals produced ZERO dihedrals (the (ia > la)
! check killed all six methyl-rotation torsions around the C1-C2 bond)
! and nint = 15 happened to equal 3*natom - 6 = 15 exactly, so the
! Cartesian-BFGS fallback was NOT triggered.  The optimizer ran with
! a complete bond/angle set but no handle on the methyl rotation,
! producing the same "stuck max|g|" pattern as ethanol.
! v0.75.0 must produce 6 dihedrals here and converge cleanly.
%method  HF
%basis   6-31G(d,p)
%job     opt+freq
%grid    fine
%charge  0
%mult    1
%spherical
%opt_maxiter  100

%geo
C       0.0000000000      0.0000000000      0.0000000000
C       0.0000000000      0.0000000000      1.5400000000
H       1.0306152474      0.0000000000      1.8948692884
H      -0.5153076237      0.8925389858      1.8948692884
H      -0.5153076237     -0.8925389858      1.8948692884
O       0.9000000000     -0.5196152423     -0.6000000000
H      -0.8175000000      0.4719838451     -0.5450000000

! v1.11.13 demo: OPEN-SHELL CDFT RELEASE (UKS Ehrenfest).  The LiH+
! doublet with the hole CDFT-constrained toward Li (charge +0.85),
! then released: coupled charge flow + nuclear motion, spin channels
! propagated independently.
%method  PBE
%basis   3-21g
%grid    1
%job     energy
%charge  1
%mult    2
%scf_ptol 1e-8
%spin unrestricted
%smearing fermi
%smearing_sigma 0.005
%cdft    becke
Li  1  charge  +0.85
%cdft_tol 1.0e-6
%cdft_maxiter 30
%ehrenfest 100
%eh_dt   2.5
%eh_esub 12
%eh_print_every 25
%geom angstrom
Li 0.0 0.0 0.0
H  0.0 0.0 1.60
*end

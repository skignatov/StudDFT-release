! v0.76.0 acceptance test: CH3O / BP86 / cc-pVDZ.  In v0.75.1 the
! SCF stalls at a near-stationary point where |dE| ~ 1e-9 but dP_max
! and |g| are at ~ 5e-5 (an order of magnitude above the new
! thresholds).  v0.76.0 must NOT silently declare convergence in
! this regime: instead it emits the "Suspicious dE-only convergence"
! diagnostic and ends with "*** SCF NOT converged" if |g| stays
! above scf_diis_etol_set.
%method  BP86
%basis   cc-pVDZ
%job     energy
%grid    tm
%charge  0
%mult    2
%spherical
%scf_maxiter 40

%geo
O   0.0000000000   0.0000000000   0.0000000000
C   1.4000000000   0.0000000000   0.0000000000
H   1.7600000000   1.0150000000   0.0000000000
H   1.7600000000  -0.5075000000   0.8790000000
H   1.7600000000  -0.5075000000  -0.8790000000
